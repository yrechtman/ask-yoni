[Unit]
Description=ask-yoni public MCP server (99% Derisible semantic search)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ask-yoni-local
EnvironmentFile=/root/ask-yoni-local/.env
ExecStart=/root/ask-yoni-local/.venv/bin/uvicorn app.server:app --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5
StandardOutput=append:/root/ask-yoni-local/logs/server.log
StandardError=append:/root/ask-yoni-local/logs/server.log

[Install]
WantedBy=multi-user.target
